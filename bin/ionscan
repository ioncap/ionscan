#!/bin/bash

# ==============================================================================
#  IONSCAN v24.0 - IMPROVED SECURITY & ROBUSTNESS EDITION
# ==============================================================================
#
#  Main entry point for the IonScan framework.
#  This script sources libraries and modules, then starts the interactive shell.
#
#  IMPROVEMENTS:
#  - Fixed eval security vulnerability
#  - Added comprehensive input validation
#  - Improved error handling with traps
#  - Better logging with timestamps and log files
#  - Refactored option parsing to reduce duplication
#  - Added history support for interactive shell
#  - Improved non-interactive mode parsing
#  - Added safety checks for auto-run mode
# ==============================================================================

# --- STRICT MODE & TRAP SETUP ---
set -o pipefail  # Catch errors in pipes
set -o nounset   # Catch unset variables

# Global cleanup on exit
cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        log_error "Script exited with code $exit_code"
    fi
}

trap cleanup EXIT
trap 'log_error "Script interrupted by user"; exit 130' INT TERM

# --- SOURCE FRAMEWORK ---
INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../" && pwd)"

# Libraries with error checking
source "$INSTALL_DIR/lib/ui.sh" || { 
    echo "ERROR: Failed to load ui.sh"; exit 1; 
}
source "$INSTALL_DIR/lib/core.sh" || { 
    echo "ERROR: Failed to load core.sh"; exit 1; 
}
source "$INSTALL_DIR/lib/network.sh" || { 
    echo "ERROR: Failed to load network.sh"; exit 1; 
}
source "$INSTALL_DIR/lib/database.sh" || { 
    echo "ERROR: Failed to load database.sh"; exit 1; 
}

# --- CONFIGURATION ---
VALID_MODULE_CATEGORIES=("recon" "exploit" "report" "post" "auxiliary")
HISTFILE="${CONFIG_DIR:-.}/.ionscan_history"
HISTSIZE=1000

# --- STATE VARIABLES ---
CURRENT_MODULE=""
DRY_RUN=false
declare -A MODULE_OPTIONS
declare -A TARGETS=([0]="demo.ionscan.org")

# Spinner state
_SPINNER_PID=""

# Module list cache (rebuilt on first use)
declare -a _MODULES_CACHE=()
_MODULES_CACHE_BUILT=false
# Last displayed numbered module list (enables 'use <number>' shortcuts)
declare -a LAST_MODULE_LIST=()

# --- UTILITY FUNCTIONS ---

# Parse a single field from module option string
# Usage: parse_module_option "$option_details" "field_name"
parse_module_option() {
    local option_details="$1"
    local field="$2"
    
    case "$field" in
        description)
            echo "$option_details" | grep -oP "(?<=description=')[^']*" || echo ""
            ;;
        required)
            echo "$option_details" | grep -oP "(?<=required=)[^ ]*" || echo "false"
            ;;
        default)
            echo "$option_details" | grep -oP "(?<=default=')[^']*" || echo ""
            ;;
        type)
            echo "$option_details" | grep -oP "(?<=type=')[^']*" || echo "string"
            ;;
        *)
            echo ""
            ;;
    esac
}

# Validate input based on type
# Usage: validate_input "value" "type"
# Returns: 0 if valid, 1 if invalid
validate_input() {
    local value="$1"
    local type="${2:-string}"

    # Helper: check all octets of an IPv4 string are 0-255
    _valid_octets() {
        local addr="$1"
        local -a octs
        IFS='.' read -ra octs <<< "$addr"
        local o
        for o in "${octs[@]}"; do
            (( 10#$o >= 0 && 10#$o <= 255 )) || return 1
        done
        return 0
    }

    case "$type" in
        ip)
            if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
                _valid_octets "$value" && return 0
            fi
            ;;
        cidr)
            if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]{1,2})$ ]]; then
                local _ip="${value%%/*}" _prefix="${value##*/}"
                _valid_octets "$_ip" && (( 10#$_prefix >= 0 && 10#$_prefix <= 32 )) && return 0
            fi
            ;;
        ip_or_cidr|target)
            if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]{1,2}))?$ ]]; then
                local _ip="${value%%/*}"
                if _valid_octets "$_ip"; then
                    if [[ "$value" == *"/"* ]]; then
                        local _prefix="${value##*/}"
                        (( 10#$_prefix >= 0 && 10#$_prefix <= 32 )) && return 0
                    else
                        return 0
                    fi
                fi
            fi
            [[ "$value" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]] && return 0
            ;;
        port)
            [[ "$value" =~ ^[0-9]+$ ]] && (( 10#$value >= 1 && 10#$value <= 65535 )) && return 0
            ;;
        port_range)
            [[ "$value" =~ ^[0-9]+-[0-9]+$ ]] && return 0
            ;;
        boolean)
            [[ "$value" =~ ^(true|false|yes|no|1|0)$ ]] && return 0
            ;;
        string|*)
            return 0
            ;;
    esac

    return 1
}

# Sanitize user input to prevent command injection
# Usage: sanitize_input "value"
sanitize_input() {
    local value="$1"
    # Remove potentially dangerous characters
    echo "$value" | sed 's/[;&|`$()]//g'
}

# Build a cached list of all available modules (category/name pairs)
_build_modules_cache() {
    _MODULES_CACHE=()
    local modules_dir="$INSTALL_DIR/modules"
    local file category mod
    for file in "$modules_dir"/*.sh; do
        [[ -f "$file" ]] || continue
        category=$(basename "$file" .sh)
        while IFS= read -r mod; do
            _MODULES_CACHE+=("${category}/${mod}")
        done < <(grep -oP '(?<=^mod_)[a-zA-Z0-9_]+' "$file" 2>/dev/null || true)
    done
    _MODULES_CACHE_BUILT=true
}

# Print all modules, building cache on first call
_get_all_modules() {
    if [[ "$_MODULES_CACHE_BUILT" != "true" ]]; then
        _build_modules_cache
    fi
    printf '%s\n' "${_MODULES_CACHE[@]}"
}

# Get the options array name for current module
get_options_array_name() {
    local module="${1:-$CURRENT_MODULE}"
    if [[ -z "$module" ]]; then
        return 1
    fi
    local name="MOD_OPTIONS_${module//\//_}"
    echo "${name^^}"
}

# --- PROGRESS SPINNER ---

start_spinner() {
    local msg="${1:-Working...}"
    if [[ ! -t 2 ]]; then return; fi
    (
        local chars='|/-\'
        local i=0
        while true; do
            i=$(( (i + 1) % 4 ))
            printf "\r${CYAN}[%s]${NC} %s  " "${chars:$i:1}" "$msg" >&2
            sleep 0.15
        done
    ) &
    _SPINNER_PID=$!
}

stop_spinner() {
    if [[ -n "${_SPINNER_PID:-}" ]] && kill -0 "$_SPINNER_PID" 2>/dev/null; then
        kill "$_SPINNER_PID" 2>/dev/null
        wait "$_SPINNER_PID" 2>/dev/null || true
        _SPINNER_PID=""
    fi
    # Clear the spinner line
    printf "\r%*s\r" "${COLUMNS:-80}" "" >&2
}

# --- SESSION PERSISTENCE ---

cmd_save_session() {
    local name="${1:-default}"
    local session_file="$LOG_DIR/session_${name}.env"

    {
        echo "# IonScan session saved $(date)"
        echo "SESSION_MODULE=${CURRENT_MODULE}"
        for key in "${!MODULE_OPTIONS[@]}"; do
            echo "SESSION_OPT_${key}=${MODULE_OPTIONS[$key]}"
        done
        for id in "${!TARGETS[@]}"; do
            echo "SESSION_TARGET_${id}=${TARGETS[$id]}"
        done
    } > "$session_file"

    log_success "Session '$name' saved to $session_file"
}

cmd_load_session() {
    local name="${1:-default}"
    local session_file="$LOG_DIR/session_${name}.env"

    if [[ ! -f "$session_file" ]]; then
        log_error "Session file not found: $session_file"
        return 1
    fi

    CURRENT_MODULE=""
    MODULE_OPTIONS=()
    TARGETS=()

    while IFS='=' read -r key value; do
        [[ "$key" =~ ^# || -z "$key" ]] && continue
        case "$key" in
            SESSION_MODULE)
                [[ -n "$value" ]] && { cmd_use "$value" 2>/dev/null || true; } ;;
            SESSION_OPT_*)
                local opt_key="${key#SESSION_OPT_}"
                MODULE_OPTIONS["$opt_key"]="$value" ;;
            SESSION_TARGET_*)
                local target_id="${key#SESSION_TARGET_}"
                TARGETS["$target_id"]="$value" ;;
        esac
    done < "$session_file"

    log_success "Session '$name' loaded."
}

# --- RUN HISTORY ---

cmd_run_history() {
    echo -e "${BOLD}Run History (last 20):${NC}"
    echo "========================================================="
    local result
    result=$(db_get_runs 20 2>/dev/null)
    if [[ -z "$result" ]]; then
        log_info "No run history available. Runs are recorded after each successful 'run' command."
        return 0
    fi
    printf "  %-5s %-28s %-22s %-8s %s\n" "ID" "Module" "Timestamp" "Duration" "Status"
    printf "  %-5s %-28s %-22s %-8s %s\n" "---" "------" "---------" "--------" "------"
    while IFS='|' read -r id mod ts dur status; do
        printf "  %-5s %-28s %-22s %-8s %s\n" "$id" "$mod" "$ts" "${dur}s" "$status"
    done <<< "$result"
    echo ""
}

cmd_replay() {
    local run_id="$1"
    if [[ -z "$run_id" || ! "$run_id" =~ ^[0-9]+$ ]]; then
        log_error "Usage: replay <run_id>  (get IDs from 'show runs')"
        return 1
    fi

    local row
    row=$(db_exec "SELECT module, options_json FROM runs WHERE id = $run_id;" 2>/dev/null)
    if [[ -z "$row" ]]; then
        log_error "No run found with ID $run_id"
        return 1
    fi

    local mod options_json
    IFS='|' read -r mod options_json <<< "$row"

    log_info "Replaying run #$run_id: $mod"
    cmd_use "$mod" || return 1

    # Restore options from the stored JSON (format: {"KEY":"val","KEY2":"val2"})
    while IFS= read -r pair; do
        local k v
        if [[ "$pair" =~ \"([^\"]+)\":\"([^\"]*)\" ]]; then
            k="${BASH_REMATCH[1]}"
            v="${BASH_REMATCH[2]}"
            [[ -n "$k" ]] && MODULE_OPTIONS["$k"]="$v"
        fi
    done < <(echo "$options_json" | grep -oP '"[^"]+":"[^"]*"' 2>/dev/null || true)

    log_info "Options restored from run #$run_id. Use 'show options' to verify, then 'run' to execute."
}

# --- DIFF ---

cmd_diff() {
    local module="${1:-$CURRENT_MODULE}"
    if [[ -z "$module" ]]; then
        log_error "Usage: diff [module_path]  (uses current module if omitted)"
        return 1
    fi

    local safe_module="${module//\'/\'\'}"
    local rows
    rows=$(db_exec "SELECT id, timestamp, options_json FROM runs WHERE module='$safe_module' ORDER BY timestamp DESC LIMIT 2;" 2>/dev/null)

    if [[ -z "$rows" ]]; then
        log_warning "No run history for '$module'. Run the module at least twice first."
        return 0
    fi

    local -a ids=() times=() opts=()
    while IFS='|' read -r id ts opt; do
        ids+=("$id"); times+=("$ts"); opts+=("$opt")
    done <<< "$rows"

    if [[ ${#ids[@]} -lt 2 ]]; then
        log_info "Only one run recorded for '$module'. Need at least 2 runs to compare."
        return 0
    fi

    echo -e "${BOLD}Diff for module '$module':${NC}"
    echo "================================================================="
    echo -e "  ${GREEN}+ Newest run #${ids[0]}${NC}: ${times[0]}"
    echo -e "  ${RED}- Previous run #${ids[1]}${NC}: ${times[1]}"
    echo ""

    if [[ "${opts[0]}" != "${opts[1]}" ]]; then
        echo -e "${BOLD}Option Changes:${NC}"
        echo -e "  Previous: ${opts[1]}"
        echo -e "  Current:  ${opts[0]}"
    else
        log_info "Options unchanged between runs."
    fi

    echo ""
    echo -e "${BOLD}Current Database State:${NC}"
    local host_count port_count vuln_count
    host_count=$(db_exec "SELECT COUNT(*) FROM hosts;" 2>/dev/null)
    port_count=$(db_exec "SELECT COUNT(*) FROM ports;" 2>/dev/null)
    vuln_count=$(db_exec "SELECT COUNT(*) FROM vulnerabilities;" 2>/dev/null)
    echo -e "  Hosts: ${host_count:-0}  |  Open Ports: ${port_count:-0}  |  Vulnerabilities: ${vuln_count:-0}"
    echo ""
}

# --- BATCH RUN ALL TARGETS ---

cmd_run_all() {
    if [[ -z "$CURRENT_MODULE" ]]; then
        log_error "No module loaded. Use 'use <module>' first."
        return 1
    fi
    if [[ ${#TARGETS[@]} -eq 0 ]]; then
        log_error "Target list is empty. Use 'add target <ip>' first."
        return 1
    fi

    log_info "Batch run: '$CURRENT_MODULE' against ${#TARGETS[@]} target(s)..."
    local success=0 fail=0
    for t in "${TARGETS[@]}"; do
        log_info "--- Target: $t ---"
        MODULE_OPTIONS[TARGET]="$t"
        if cmd_run; then
            success=$(( success + 1 ))
        else
            fail=$(( fail + 1 ))
        fi
    done
    log_success "Batch complete: $success succeeded, $fail failed."
}

# --- COMMAND HANDLERS ---

cmd_help() {
    echo -e "${BOLD}IonScan Interactive Shell - v24.0${NC}"
    echo "====================================="
    echo ""
    echo -e "${BOLD}Core Commands:${NC}"
    echo "  help              Show this help message"
    echo "  show modules      List all available modules (numbered)"
    echo "  show options      Show options for the current module"
    echo "  show targets      Show the current list of targets"
    echo "  show runs         Show module execution history"
    echo "  add target <ip>   Add a target to the target list"
    echo "  rm target <id>    Remove a target from the list"
    echo "  use <module>      Select a module (full path, partial name, or number)"
    echo "  set <key> <val>   Set an option for the current module"
    echo "  run               Run the current module"
    echo "  run all           Run the current module against every target in list"
    echo "  replay <id>       Re-run a previous run by ID (from 'show runs')"
    echo "  diff [module]     Compare last two runs of a module"
    echo "  save [name]       Save current session state to file"
    echo "  load [name]       Load a previously saved session"
    echo "  back              Deselect the current module"
    echo "  search <term>     Search modules by keyword"
    echo "  exit              Exit IonScan"
    echo ""
    echo -e "${BOLD}Shortcuts:${NC}"
    echo "  ls / modules      Alias for 'show modules'"
    echo "  opts / options    Alias for 'show options'"
    echo "  targets           Alias for 'show targets'"
    echo "  runs              Alias for 'show runs'"
    echo "  use <number>      Select module by number (from 'show modules' list)"
    echo "  use <partial>     Fuzzy match — e.g., 'use fast_scan' or 'use vuln'"
    echo ""
    echo -e "${BOLD}Flags (CLI):${NC}"
    echo "  --dry-run         Print commands without executing them"
    echo "  --auto            Headless auto-scan mode"
    echo "  --agree           Skip disclaimer"
    echo ""
    echo -e "${BOLD}Tab Completion:${NC}"
    echo "  TAB after 'use'   Complete module names"
    echo "  TAB after 'set'   Complete option keys for the current module"
    echo "  TAB after 'show'  Complete subcommand names"
    echo "  TAB on empty line Complete command names"
    echo ""
    echo -e "${BOLD}Tips:${NC}"
    echo "  - Required options shown in ${RED}red${NC}, set options in ${GREEN}green${NC}"
    echo "  - Use UP/DOWN arrows for command history"
    echo "  - Valid module categories: ${VALID_MODULE_CATEGORIES[*]}"
    echo ""
}

cmd_exit() {
    log_info "Exiting IonScan. Goodbye!"
    exit 0
}

cmd_show() {
    local sub_cmd="$1"
    case "$sub_cmd" in
        modules)
            echo -e "${BOLD}Available Modules:${NC}"
            echo "===================="

            # Rebuild cache so LAST_MODULE_LIST is fresh
            _build_modules_cache
            LAST_MODULE_LIST=()

            if [[ ${#_MODULES_CACHE[@]} -eq 0 ]]; then
                log_warning "No modules found"
                return 0
            fi

            local prev_category="" n=1 entry category
            for entry in "${_MODULES_CACHE[@]}"; do
                category="${entry%%/*}"
                # Skip modules in disabled categories
                local cat_enabled
                cat_enabled=$(get_config "MODULE_${category^^}_ENABLED" 2>/dev/null)
                [[ "$cat_enabled" == "false" ]] && continue

                if [[ "$category" != "$prev_category" ]]; then
                    echo -e "  ${CYAN}${category}${NC}:"
                    prev_category="$category"
                fi
                printf "    ${BOLD}%2d${NC}  %s\n" "$n" "$entry"
                LAST_MODULE_LIST+=("$entry")
                n=$((n + 1))
            done
            echo ""
            echo -e "  ${BOLD}Tip:${NC} type 'use <number>' to load a module by its index"
            echo ""
            ;;
        options)
            if [[ -z "$CURRENT_MODULE" ]]; then
                log_error "No module is currently loaded. Use 'use <module>' first."
                return 1
            fi
            
            echo -e "${BOLD}Module Options for: ${RED}${CURRENT_MODULE}${NC}"
            echo "================================================="
            
            local options_array_name
            options_array_name=$(get_options_array_name) || {
                log_error "Failed to get options array name"
                return 1
            }

            if ! declare -p "$options_array_name" &>/dev/null; then
                log_warning "Module has no configurable options."
                return 0
            fi

            declare -n ref_options_array="$options_array_name"
            
            printf "  %-15s %-20s %-10s %-10s %s\n" "Name" "Current Setting" "Required" "Type" "Description"
            printf "  %-15s %-20s %-10s %-10s %s\n" "----" "---------------" "--------" "----" "-----------"

            for key in "${!ref_options_array[@]}"; do
                local option_details="${ref_options_array[$key]}"

                local description
                description=$(parse_module_option "$option_details" "description")
                local required
                required=$(parse_module_option "$option_details" "required")
                local default_val
                default_val=$(parse_module_option "$option_details" "default")
                local type_val
                type_val=$(parse_module_option "$option_details" "type")

                local current_val="${MODULE_OPTIONS[$key]:-$default_val}"
                [[ -z "$current_val" ]] && current_val="<not set>"

                # Color the key: RED = required+unset, GREEN = required+set, CYAN = optional+set
                local key_color="$NC"
                if [[ "$required" == "true" ]]; then
                    if [[ "$current_val" == "<not set>" ]]; then
                        key_color="$RED"
                    else
                        key_color="$GREEN"
                    fi
                elif [[ "$current_val" != "<not set>" ]]; then
                    key_color="$CYAN"
                fi

                printf "  ${key_color}%-15s${NC} %-20s %-10s %-10s %s\n" \
                    "$key" "$current_val" "$required" "$type_val" "$description"
            done
            echo ""
            ;; 
        targets)
            echo -e "${BOLD}Current Targets:${NC}"
            echo "================"
            if [[ ${#TARGETS[@]} -eq 0 ]]; then
                log_info "No targets have been added."
            else
                printf "  %-5s %s\n" "ID" "Target"
                printf "  %-5s %s\n" "---" "------"
                for id in "${!TARGETS[@]}"; do
                    printf "  %-5s %s\n" "$id" "${TARGETS[$id]}"
                done
            fi
            echo ""
            ;; 
        history)
            if [[ -f "$HISTFILE" ]]; then
                echo -e "${BOLD}Command History:${NC}"
                echo "================"
                tail -n 20 "$HISTFILE"
                echo ""
            else
                log_info "No command history available."
            fi
            ;;
        runs)
            cmd_run_history
            ;;
        *)
            log_error "Unknown 'show' command: '$sub_cmd'."
            log_info "Available: modules, options, targets, history, runs"
            return 1
            ;; 
    esac
}

cmd_add_target() {
    local -n targets_ref="$1"
    local target_to_add="$2"
    
    if [[ -z "$target_to_add" ]]; then
        log_error "Usage: add target <ip/domain/cidr>"
        return 1
    fi
    
    # Validate target format
    if ! validate_input "$target_to_add" "target"; then
        log_error "Invalid target format: '$target_to_add'"
        log_info "Valid formats: IP (192.168.1.1), CIDR (192.168.1.0/24), or domain (example.com)"
        return 1
    fi
    
    # Check for duplicates
    for id in "${!targets_ref[@]}"; do
        if [[ "${targets_ref[$id]}" == "$target_to_add" ]]; then
            log_warning "Target '$target_to_add' already exists with ID $id"
            return 0
        fi
    done
    
    # Find next available ID
    local max_id=0
    for id in "${!targets_ref[@]}"; do
        if (( id > max_id )); then
            max_id=$id
        fi
    done
    local next_id=$(( max_id + 1 ))
    
    targets_ref[$next_id]="$target_to_add"
    log_success "Added target $next_id: $target_to_add"
}

cmd_rm_target() {
    local -n targets_ref="$1"
    local target_id_to_remove="$2"
    
    if [[ -z "$target_id_to_remove" ]]; then
        log_error "Usage: rm target <id>"
        return 1
    fi
    
    # Validate ID is numeric
    if ! [[ "$target_id_to_remove" =~ ^[0-9]+$ ]]; then
        log_error "Invalid target ID: '$target_id_to_remove' (must be numeric)"
        return 1
    fi
    
    if [[ -v "targets_ref[$target_id_to_remove]" ]]; then
        local target_value="${targets_ref[$target_id_to_remove]}"
        unset "targets_ref[$target_id_to_remove]"
        log_success "Removed target $target_id_to_remove: $target_value"
    else
        log_error "Invalid target ID: $target_id_to_remove"
        log_info "Use 'show targets' to see available targets"
        return 1
    fi
}

cmd_use() {
    local module_name="$1"

    if [[ -z "$module_name" ]]; then
        log_error "Usage: use <module|number|partial-name>"
        return 1
    fi

    # --- Selection by number (from last 'show modules' output) ---
    if [[ "$module_name" =~ ^[0-9]+$ ]]; then
        local idx=$(( module_name - 1 ))
        if [[ $idx -ge 0 && $idx -lt ${#LAST_MODULE_LIST[@]} ]]; then
            module_name="${LAST_MODULE_LIST[$idx]}"
            log_info "Selected: $module_name"
        else
            log_error "No module #${module_name}. Run 'show modules' to see the list."
            return 1
        fi
    fi

    # --- Fuzzy match: no slash → search by name across categories ---
    if [[ ! "$module_name" =~ "/" ]]; then
        local -a candidates=()
        # Exact name match first (e.g. 'fast_scan' → 'recon/fast_scan')
        mapfile -t candidates < <(_get_all_modules | grep -i "/${module_name}$" 2>/dev/null || true)
        # Fall back to substring match if no exact name match
        if [[ ${#candidates[@]} -eq 0 ]]; then
            mapfile -t candidates < <(_get_all_modules | grep -i "${module_name}" 2>/dev/null || true)
        fi
        if [[ ${#candidates[@]} -eq 1 ]]; then
            module_name="${candidates[0]}"
            log_info "Matched: $module_name"
        elif [[ ${#candidates[@]} -gt 1 ]]; then
            log_warning "Ambiguous: multiple modules match '${1}':"
            local c; for c in "${candidates[@]}"; do echo "    $c"; done
            log_info "Be more specific or use 'show modules' to pick by number."
            return 1
        else
            log_error "No module found matching '${1}'. Try 'search ${1}' or 'show modules'."
            return 1
        fi
    fi

    # --- Validate full category/name format ---
    if ! [[ "$module_name" =~ ^[a-zA-Z0-9_]+/[a-zA-Z0-9_]+$ ]]; then
        log_error "Invalid module name format. Should be 'category/module'."
        log_info "Example: use recon/fast_scan"
        return 1
    fi
    
    local module_category
    module_category=$(echo "$module_name" | cut -d'/' -f1)
    local module_sub_name
    module_sub_name=$(echo "$module_name" | cut -d'/' -f2)
    
    # Validate category is in whitelist
    local valid_category=false
    for cat in "${VALID_MODULE_CATEGORIES[@]}"; do
        if [[ "$cat" == "$module_category" ]]; then
            valid_category=true
            break
        fi
    done
    
    if [[ "$valid_category" == "false" ]]; then
        log_error "Invalid module category: '$module_category'"
        log_info "Valid categories: ${VALID_MODULE_CATEGORIES[*]}"
        return 1
    fi

    # Check if the module category is enabled in config
    local cat_enabled
    cat_enabled=$(get_config "MODULE_${module_category^^}_ENABLED" 2>/dev/null)
    if [[ "$cat_enabled" == "false" ]]; then
        log_error "Module category '$module_category' is disabled (MODULE_${module_category^^}_ENABLED=false in config)."
        return 1
    fi

    local module_path="$INSTALL_DIR/modules/${module_category}.sh"

    if [[ ! -f "$module_path" ]]; then
        log_error "Module file not found: $module_path"
        log_info "Use 'show modules' to see available modules"
        return 1
    fi
    
    # Source the module file
    source "$module_path" || {
        log_error "Failed to source module file: $module_path"
        return 1
    }
    
    # Check if the sub-module function exists
    local func_name="mod_${module_sub_name}"
    if ! command -v "$func_name" >/dev/null 2>&1; then
        log_error "Sub-module '$module_sub_name' not found in '$module_category'."
        log_info "Available modules in $module_category:"
        grep -oP "(?<=^mod_)[a-zA-Z0-9_]+" "$module_path" 2>/dev/null | sed 's/^/  - /'
        return 1
    fi
    
    # Successfully loaded module
    CURRENT_MODULE="$module_name"
    MODULE_OPTIONS=()
    log_success "Module '$module_name' loaded."
    
    # Load default values from module options
    local options_array_name
    options_array_name=$(get_options_array_name)

    if declare -p "$options_array_name" &>/dev/null; then
        declare -n ref_options_array="$options_array_name"
        for key in "${!ref_options_array[@]}"; do
            local option_details="${ref_options_array[$key]}"
            local default_val
            default_val=$(parse_module_option "$option_details" "default")
            if [[ -n "$default_val" ]]; then
                MODULE_OPTIONS[$key]="$default_val"
            fi
        done
        log_info "Use 'show options' to see available options for this module."
    fi
}

cmd_back() {
    if [[ -n "$CURRENT_MODULE" ]]; then
        log_info "Unloaded module '$CURRENT_MODULE'."
        CURRENT_MODULE=""
        MODULE_OPTIONS=()
    else
        log_warning "No module is currently loaded."
    fi
}

cmd_set() {
    local args_line="$1"
    local key
    key=$(echo "$args_line" | awk '{print $1}')
    local value
    value=$(echo "$args_line" | cut -d' ' -f2-)
    
    if [[ -z "$key" || -z "$value" || "$key" == "$value" ]]; then
        log_error "Usage: set <option_name> <value>"
        return 1
    fi
    
    # Alias RHOSTS to TARGET for Metasploit compatibility
    if [[ "$key" == "RHOSTS" ]]; then
        key="TARGET"
        log_info "Note: RHOSTS aliased to TARGET"
    fi

    if [[ -z "$CURRENT_MODULE" ]]; then
        log_error "No module loaded. Use 'use <module>' first."
        return 1
    fi
    
    local options_array_name
    options_array_name=$(get_options_array_name) || {
        log_error "Failed to get options for current module"
        return 1
    }
    
    if ! declare -p "$options_array_name" &>/dev/null; then
        log_error "Module has no options to set."
        return 1
    fi
    
    declare -n ref_options_array="$options_array_name"
    
    if [[ ! -v "ref_options_array[$key]" ]]; then
        log_error "Unknown option for this module: '$key'"
        log_info "Use 'show options' to see available options"
        return 1
    fi
    
    # Get option details for validation
    local option_details="${ref_options_array[$key]}"
    local type_val
    type_val=$(parse_module_option "$option_details" "type")
    
    # Validate input based on type
    if ! validate_input "$value" "$type_val"; then
        log_error "Invalid value '$value' for option '$key' (expected type: $type_val)"
        return 1
    fi
    
    # Sanitize the value
    local sanitized_value
    sanitized_value=$(sanitize_input "$value")
    
    MODULE_OPTIONS[$key]="$sanitized_value"
    log_success "$key => $sanitized_value"
}

cmd_run() {
    if [[ -z "$CURRENT_MODULE" ]]; then
        log_error "No module loaded to run. Use 'use <module>' first."
        return 1
    fi
    
    local module_sub_name
    module_sub_name=$(echo "$CURRENT_MODULE" | cut -d'/' -f2)
    local func_to_run="mod_${module_sub_name}"

    if ! command -v "$func_to_run" >/dev/null 2>&1; then
        log_error "Cannot find function '$func_to_run' for module '$CURRENT_MODULE'."
        return 1
    fi
    
    # Validate required options are set
    local options_array_name
    options_array_name=$(get_options_array_name)

    if declare -p "$options_array_name" &>/dev/null; then
        declare -n ref_options_array="$options_array_name"
        local missing_required=()
        
        for key in "${!ref_options_array[@]}"; do
            local option_details="${ref_options_array[$key]}"
            local required
            required=$(parse_module_option "$option_details" "required")
            
            if [[ "$required" == "true" ]]; then
                if [[ -z "${MODULE_OPTIONS[$key]:-}" ]]; then
                    missing_required+=("$key")
                fi
            fi
        done
        
        if [[ ${#missing_required[@]} -gt 0 ]]; then
            log_error "Required options not set: ${missing_required[*]}"
            log_info "Use 'show options' to see required options and 'set <option> <value>' to set them."
            return 1
        fi
    fi
    
    # Dry-run mode: print what would run without executing
    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "[DRY RUN] Would execute: $func_to_run"
        log_info "[DRY RUN] Options:"
        for key in "${!MODULE_OPTIONS[@]}"; do
            log_info "[DRY RUN]   $key = ${MODULE_OPTIONS[$key]}"
        done
        return 0
    fi

    # Create log file for this run
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local log_file="$LOG_DIR/module_${CURRENT_MODULE//\//_}_${timestamp}.log"

    mkdir -p "$LOG_DIR" 2>/dev/null || true

    local start_time
    start_time=$(date +%s)

    log_info "Running module: $CURRENT_MODULE..."
    log_info "Logging to: $log_file"

    {
        echo "=== Module Run: $CURRENT_MODULE ==="
        echo "=== Timestamp: $(date) ==="
        echo "=== Options: ==="
        for key in "${!MODULE_OPTIONS[@]}"; do
            echo "  $key = ${MODULE_OPTIONS[$key]}"
        done
        echo "=== Output: ==="
    } | tee "$log_file"

    # Build a compact JSON snapshot of current options for run history
    local _opts_json="{"
    local _first_opt=true
    for key in "${!MODULE_OPTIONS[@]}"; do
        [[ "$_first_opt" == "true" ]] || _opts_json+=","
        _opts_json+="\"${key}\":\"${MODULE_OPTIONS[$key]//\"/\\\"}\""
        _first_opt=false
    done
    _opts_json+="}"

    # Show spinner while module runs
    start_spinner "Running $CURRENT_MODULE..."

    if "$func_to_run" 2>&1 | tee -a "$log_file"; then
        stop_spinner
        local end_time
        end_time=$(date +%s)
        local duration=$(( end_time - start_time ))

        log_success "Module completed successfully in ${duration}s"
        echo "=== Completed at: $(date) ===" | tee -a "$log_file"

        # Record successful run in the database
        db_add_run "$CURRENT_MODULE" "$duration" "success" "$_opts_json" 2>/dev/null || true
    else
        stop_spinner
        local exit_code=$?
        local end_time
        end_time=$(date +%s)
        local duration=$(( end_time - start_time ))

        log_error "Module failed with exit code $exit_code after ${duration}s"
        echo "=== Failed at: $(date) with exit code $exit_code ===" | tee -a "$log_file"

        db_add_run "$CURRENT_MODULE" "$duration" "failed" "$_opts_json" 2>/dev/null || true
        return $exit_code
    fi
}

# Search modules by keyword
cmd_search() {
    local term="${1:-}"
    if [[ -z "$term" ]]; then
        log_error "Usage: search <keyword>"
        return 1
    fi

    local -a results=()
    mapfile -t results < <(_get_all_modules | grep -i "$term" 2>/dev/null || true)

    if [[ ${#results[@]} -eq 0 ]]; then
        log_warning "No modules found matching '${term}'"
        return 0
    fi

    echo -e "${BOLD}Search results for '${term}':${NC}"
    local n=1 entry
    for entry in "${results[@]}"; do
        printf "  ${BOLD}%2d${NC}  %s\n" "$n" "$entry"
        n=$((n + 1))
    done
    echo ""
}

# Set up readline tab-completion for the interactive shell
setup_readline_completion() {
    _ionscan_tab_complete() {
        local before_cursor="${READLINE_LINE:0:$READLINE_POINT}"

        # Split words; detect whether we're starting a new word (trailing space)
        local -a words=()
        read -ra words <<< "$before_cursor"
        local cur_word=""
        if [[ ! "$before_cursor" =~ [[:space:]]$ ]]; then
            cur_word="${words[-1]:-}"
        fi
        local prefix="${before_cursor%$cur_word}"
        local first_word="${words[0]:-}"
        # num_words counts completed words + partial current word
        local num_words=${#words[@]}
        [[ "$before_cursor" =~ [[:space:]]$ ]] && num_words=$(( num_words + 1 ))

        local -a matches=()

        case "$first_word" in
            ""|help|show|use|set|run|back|exit|quit|add|rm|search|ls|opts|options|targets|info|runs|replay|diff|save|load)
                if [[ $num_words -le 1 ]]; then
                    # Complete command name
                    local all_cmds="help show use set run back exit quit add rm search ls opts options targets info runs replay diff save load"
                    mapfile -t matches < <(compgen -W "$all_cmds" -- "$cur_word")

                elif [[ "$first_word" == "use" && $num_words -eq 2 ]]; then
                    # Complete module path
                    mapfile -t matches < <(_get_all_modules | grep -i "^${cur_word}" 2>/dev/null || true)

                elif [[ "$first_word" == "set" && $num_words -eq 2 ]]; then
                    # Complete option key for current module
                    if [[ -n "$CURRENT_MODULE" ]]; then
                        local opts_array_name
                        opts_array_name=$(get_options_array_name 2>/dev/null) || return
                        if declare -p "$opts_array_name" &>/dev/null; then
                            declare -n _tc_opts="$opts_array_name"
                            mapfile -t matches < <(printf '%s\n' "${!_tc_opts[@]}" | grep -i "^${cur_word}" 2>/dev/null || true)
                        fi
                    fi

                elif [[ "$first_word" == "show" && $num_words -eq 2 ]]; then
                    mapfile -t matches < <(compgen -W "modules options targets history runs" -- "$cur_word")

                elif [[ ("$first_word" == "add" || "$first_word" == "rm") && $num_words -eq 2 ]]; then
                    mapfile -t matches < <(compgen -W "target" -- "$cur_word")
                fi
                ;;
        esac

        if [[ ${#matches[@]} -eq 0 ]]; then
            return
        elif [[ ${#matches[@]} -eq 1 ]]; then
            # Single match — complete in place with a trailing space
            local completion="${matches[0]}"
            READLINE_LINE="${prefix}${completion} ${READLINE_LINE:$READLINE_POINT}"
            READLINE_POINT=$(( ${#prefix} + ${#completion} + 1 ))
        else
            # Multiple matches — print list, let readline redraw the prompt
            echo ""
            printf '%s\n' "${matches[@]}" | column -c "${COLUMNS:-80}"
        fi
    }

    bind -x '"\t": _ionscan_tab_complete'
}

# --- INTERACTIVE SHELL ---

interactive_shell() {
    # Enable command history and tab completion
    set -o history
    setup_readline_completion

    while true; do
        local prompt="ionscan"
        if [[ -n "$CURRENT_MODULE" ]]; then
            prompt="${prompt} (${RED}${CURRENT_MODULE}${NC})"
        fi
        prompt="${prompt} > "

        read -rep "$prompt" line

        # Add to history if non-empty
        if [[ -n "$line" ]]; then
            history -s "$line"
        fi

        # Parse command and arguments
        local cmd args
        read -r cmd args <<< "$line"

        # Handle commands
        case "$cmd" in
            help|"?")
                cmd_help
                ;;
            # --- Short aliases ---
            ls|modules)
                cmd_show "modules"
                ;;
            opts|options)
                cmd_show "options"
                ;;
            targets)
                cmd_show "targets"
                ;;
            info)
                cmd_show "options"
                ;;
            search)
                cmd_search "$args"
                ;;
            # --- Standard commands ---
            show)
                cmd_show "$args"
                ;;
            add)
                if [[ "$args" == "target "* ]]; then
                    cmd_add_target "TARGETS" "${args#target }"
                else
                    log_error "Usage: add target <ip/domain/cidr>"
                fi
                ;;
            rm)
                if [[ "$args" == "target "* ]]; then
                    cmd_rm_target "TARGETS" "${args#target }"
                else
                    log_error "Usage: rm target <id>"
                fi
                ;;
            use)
                cmd_use "$args"
                ;;
            set)
                cmd_set "$args"
                ;;
            run)
                if [[ "$args" == "all" ]]; then
                    cmd_run_all
                else
                    cmd_run
                fi
                ;;
            replay)
                cmd_replay "$args"
                ;;
            diff)
                cmd_diff "$args"
                ;;
            save)
                cmd_save_session "$args"
                ;;
            load)
                cmd_load_session "$args"
                ;;
            runs)
                cmd_run_history
                ;;
            back)
                cmd_back
                ;;
            exit|quit)
                cmd_exit
                ;;
            "")
                # Empty line — do nothing
                ;;
            *)
                log_error "Unknown command: '$cmd'. Type 'help' or '?' for commands."
                ;;
        esac
    done
}

# --- SETUP FUNCTION ---

run_setup() {
    log_info "Running setup..."
    local missing_deps=()
    local deps_to_check=( "nmap" "sqlite3" "nbtscan" )

    log_info "Checking for required dependencies..."
    for dep in "${deps_to_check[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            log_warning "Dependency '$dep' is not installed."
            missing_deps+=("$dep")
        else
            log_success "Dependency '$dep' is already installed."
        fi
    done

    if [[ ${#missing_deps[@]} -eq 0 ]]; then
        log_success "All dependencies are satisfied."
        exit 0
    fi

    echo -e "${YELLOW}The following dependencies are missing: ${missing_deps[*]}${NC}"
    read -rp "Do you want to install them? [y/N] " choice
    if [[ ! "$choice" =~ ^[Yy]$ ]]; then
        log_error "Installation aborted by user."
        exit 1
    fi

    log_info "Attempting to install missing dependencies..."
    if command -v apt-get &> /dev/null; then
        sudo apt-get update && sudo apt-get install -y "${missing_deps[@]}"
        if [[ $? -eq 0 ]]; then
            log_success "Dependencies installed successfully using apt-get."
        else
            log_error "Failed to install dependencies using apt-get."
            exit 1
        fi
    elif command -v yum &> /dev/null; then
        sudo yum install -y "${missing_deps[@]}"
        if [[ $? -eq 0 ]]; then
            log_success "Dependencies installed successfully using yum."
        else
            log_error "Failed to install dependencies using yum."
            exit 1
        fi
    elif command -v dnf &> /dev/null; then
        sudo dnf install -y "${missing_deps[@]}"
        if [[ $? -eq 0 ]]; then
            log_success "Dependencies installed successfully using dnf."
        else
            log_error "Failed to install dependencies using dnf."
            exit 1
        fi
    else
        log_error "No supported package manager found. Please install dependencies manually."
        exit 1
    fi

    log_success "Setup complete."
}

# --- MAIN ENTRY ---

main() {
    # Handle command-line arguments
    local remaining_args=()
    local auto_run=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --setup)
                run_setup
                exit 0
                ;;
            --agree)
                export AGREED="true"
                shift
                ;;
            --help)
                show_help 2>/dev/null || cmd_help
                exit 0
                ;;
            --auto)
                auto_run=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                export IONSCAN_DRY_RUN=true
                log_info "Dry-run mode enabled. Commands will be printed but not executed."
                shift
                ;;
            *)
                remaining_args+=("$1")
                shift
                ;;
        esac
    done
    
    # Restore non-flag arguments
    set -- "${remaining_args[@]}"

    # Auto-run mode setup with safety checks
    if [[ "$auto_run" == "true" ]]; then
        get_interface 2>/dev/null || true
        local local_subnet
        local_subnet=$(echo "${MY_IP:-192.168.1.0}" | cut -d'.' -f1-3).0/24
        
        log_warning "AUTO MODE ENABLED"
        log_warning "This will scan local subnet: $local_subnet"
        log_warning "This may trigger IDS/IPS systems and network monitoring alerts!"
        
        if [[ "${AGREED:-}" != "true" ]]; then
            read -rp "Continue with auto-run? [y/N] " choice
            if [[ ! "$choice" =~ ^[Yy]$ ]]; then
                log_error "Auto-run cancelled by user"
                exit 1
            fi
        fi
        
        set -- "use" "recon/fast_scan" "set" "TARGET" "$local_subnet" "run" \
               "use" "exploit/advanced_vuln" "set" "TARGET" "$local_subnet" "run" \
               "use" "report/report" "set" "AUTO_OPEN" "true" "run" "$@"
    fi

    # Initialize framework
    setup_config 2>/dev/null || true
    db_init 2>/dev/null || log_warning "Database initialization failed"

    # Check and fix log directory permissions
    if [[ -d "${LOG_DIR:-}" ]] && [[ ! -w "${LOG_DIR:-}" ]]; then
        local owner="${SUDO_USER:-$(whoami)}"
        log_warning "Log directory not writable. Attempting to fix with 'sudo chown'..."
        sudo chown -R "$owner" "$LOG_DIR" 2>/dev/null || {
            log_error "Failed to set permissions on $LOG_DIR. Please fix manually."
        }
    fi

    # Start interactive or non-interactive mode
    if [[ $# -eq 0 ]]; then
        # Interactive mode
        header 2>/dev/null || echo "=== IonScan v24.0 ==="
        
        # Disclaimer check
        if [[ "${AGREED:-}" != "true" ]]; then
            echo -e "${RED}${BOLD}DISCLAIMER${NC}"
            echo "This tool is for educational and authorized use only."
            echo "Unauthorized network scanning is illegal."
            echo ""
            read -rp "Do you agree to use this tool responsibly? [y/N] " A
            if [[ ! "$A" =~ ^[Yy]$ ]]; then 
                log_error "You must agree to the terms to use this tool."
                exit 1
            fi
        fi
        
        interactive_shell
    else
        # Non-interactive mode
        header 2>/dev/null || echo "=== IonScan v24.0 ==="
        
        if [[ "${AGREED:-}" != "true" ]]; then
            log_error "DISCLAIMER: This tool is for educational and authorized use only."
            log_error "Run with the --agree flag to accept the terms."
            exit 1
        fi

        # Execute commands from arguments
        local i=0
        while [[ $i -lt $# ]]; do
            local cmd="${!i}"
            i=$((i + 1))
            
            case "$cmd" in
                use)
                    if [[ $i -le $# ]]; then
                        local module="${!i}"
                        cmd_use "$module"
                        i=$((i + 1))
                    else
                        log_error "Missing argument for 'use' command"
                    fi
                    ;;
                set)
                    if [[ $i -le $# ]]; then
                        local key="${!i}"
                        i=$((i + 1))
                        
                        # Collect value parts until next command
                        local value=""
                        while [[ $i -le $# ]]; do
                            local next_arg="${!i}"
                            if [[ "$next_arg" =~ ^(use|set|run|add|rm|show|back|exit)$ ]]; then
                                break
                            fi
                            if [[ -n "$value" ]]; then
                                value+=" "
                            fi
                            value+="$next_arg"
                            i=$((i+1))
                        done
                        
                        cmd_set "$key $value"
                    else
                        log_error "Missing arguments for 'set' command"
                    fi
                    ;;
                run)
                    cmd_run
                    ;;
                add)
                    if [[ $i -le $# ]] && [[ "${!i}" == "target" ]]; then
                        i=$((i+1))
                        if [[ $i -le $# ]]; then
                            local target_val="${!i}"
                            i=$((i+1))
                            cmd_add_target "TARGETS" "$target_val"
                        else
                            log_error "Missing target value"
                        fi
                    else
                        log_error "Invalid add command syntax"
                    fi
                    ;;
                rm)
                    if [[ $i -le $# ]] && [[ "${!i}" == "target" ]]; then
                        i=$((i+1))
                        if [[ $i -le $# ]]; then
                            local target_id="${!i}"
                            i=$((i+1))
                            cmd_rm_target "TARGETS" "$target_id"
                        else
                            log_error "Missing target ID"
                        fi
                    else
                        log_error "Invalid rm command syntax"
                    fi
                    ;;
                show)
                    if [[ $i -le $# ]]; then
                        local sub_cmd="${!i}"
                        i=$((i+1))
                        cmd_show "$sub_cmd"
                    else
                        log_error "Missing argument for 'show' command"
                    fi
                    ;;
                back)
                    cmd_back
                    ;;
                exit|quit)
                    cmd_exit
                    ;;
                *)
                    log_error "Unknown command in non-interactive mode: $cmd"
                    log_info "Valid commands: use, set, run, add, rm, show, back, exit"
                    exit 1
                    ;;
            esac
        done
    fi
}

main "$@"
